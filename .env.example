# ---------------------------------------------------------------------------
# The RAG backend (manhwa-rag). Start it first:
#   docker compose up -d && python -m scripts.serve
# It takes 60-90s to warm the embedding model; the bot reports "still warming
# up" until /health answers, rather than timing out at the user.
# ---------------------------------------------------------------------------
RAG_URL=http://127.0.0.1:8000
RAG_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Telegram. Get a token from @BotFather (free, instant, no verification).
# Long polling, so no public URL and no tunnel are required.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# Chat id that receives escalation notices. Message @userinfobot to find yours.
# Left empty, escalations are still recorded to the database, just not pushed.
ADMIN_CHAT_ID=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API. From a Meta for Developers app with the WhatsApp product
# added. The test number can only message recipients you have verified.
# WHATSAPP_VERIFY_TOKEN is a string you invent; Meta echoes it back during the
# webhook handshake to prove the endpoint is yours.
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret (App settings > Basic). Required: the webhook rejects unsigned POSTs.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Discord. Create an application at discord.com/developers, add a bot, copy the
# token. Free, no approval, no verification until 100 servers.
#
# The bot uses slash commands only, so it needs NO privileged intents — leave
# Message Content switched off. Invite it with the `bot` and
# `applications.commands` scopes.
#
# DISCORD_GUILD_ID makes commands appear instantly in that one server. Without
# it they register globally and can take up to an hour to show up.
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Reddit, for looking up real communities (/communities).
#
# Only app-only OAuth is needed — no Reddit account password. Note that Reddit's
# Responsible Builder Policy now requires approval before API access, so this
# may need a request rather than self-service registration.
#
# Left empty, the bot still answers catalogue questions and /communities says it
# is switched off rather than inventing subreddit names.
#
# The user agent must be descriptive and must not be masked; put your own
# Reddit username in it.
# ---------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:manga-chatbot:v0.1 (by /u/your-username)

# ---------------------------------------------------------------------------
# Preference capture store.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./manga_chatbot.db

# ---------------------------------------------------------------------------
# Rate limiting. The backend is single-tenant with no auth of its own and the
# free Groq tier is 100k tokens/day, so the bot is the front door that protects
# it.
# ---------------------------------------------------------------------------
RATE_LIMIT_MIN_SECONDS=3
RATE_LIMIT_PER_HOUR=20

# Must match API_KEY in manhwa-rag/.env when the backend is protected.
RAG_API_KEY=
