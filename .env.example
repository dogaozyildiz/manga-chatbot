# ---------------------------------------------------------------------------
# The RAG backend (manhwa-rag). Start it first:
#   docker compose up -d && python -m scripts.serve
# It takes 60-90s to warm the embedding model; the bot reports "still warming
# up" until /health answers, rather than timing out at the user.
# ---------------------------------------------------------------------------
RAG_URL=http://127.0.0.1:8000
RAG_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Telegram. Get a token from @BotFather (free, instant, no verification).
# Long polling, so no public URL and no tunnel are required.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# Chat id that receives escalation notices. Message @userinfobot to find yours.
# Left empty, escalations are still recorded to the database, just not pushed.
ADMIN_CHAT_ID=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API. From a Meta for Developers app with the WhatsApp product
# added. The test number can only message recipients you have verified.
# WHATSAPP_VERIFY_TOKEN is a string you invent; Meta echoes it back during the
# webhook handshake to prove the endpoint is yours.
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Preference capture store.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./manga_chatbot.db

# ---------------------------------------------------------------------------
# Rate limiting. The backend is single-tenant with no auth of its own and the
# free Groq tier is 100k tokens/day, so the bot is the front door that protects
# it.
# ---------------------------------------------------------------------------
RATE_LIMIT_MIN_SECONDS=3
RATE_LIMIT_PER_HOUR=20
